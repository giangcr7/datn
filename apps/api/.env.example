NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://diplomachain_app:replace-runtime-password@127.0.0.1:5432/diplomachain
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_URL=http://localhost:3000
PUBLIC_DIRECTORY_ENABLED=false
FABRIC_ENABLED=false
FABRIC_NETWORK_BASE=D:/datn/diplomachain
FABRIC_CHANNEL=diploma
FABRIC_CHAINCODE=educert
ORG1_WALLET_PATH=D:/datn/diplomachain/wallet/issuer-org1.json
FABRIC_TLS_SKIP_VERIFY=false
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../.data/documents
STORAGE_S3_BUCKET=
AWS_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_KMS_KEY_ID=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=DiplomaChain <noreply@example.com>
OUTBOX_ENABLED=true
DEFAULT_INSTITUTION_CODE=TLU
DEFAULT_CAMPUS_CODE=ORG2
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG1_EMAIL=
BOOTSTRAP_ORG1_PASSWORD=
BOOTSTRAP_ORG2_EMAIL=
BOOTSTRAP_ORG2_PASSWORD=
PDF_SIGNING_MODE=disabled
PDF_ORG1_P12_PATH=
PDF_ORG1_PASSWORD=
PDF_ORG1_CERT_SHA256=
PDF_ORG2_P12_PATH=
PDF_ORG2_PASSWORD=
PDF_ORG2_CERT_SHA256=
PDF_PKI_ENABLED=false
PDF_TSA_URL=
PDF_PKI_TRUST_BUNDLE_PATH=
PDF_PKI_ISSUERS_PATH=
PDF_PKI_ENDPOINTS_PATH=
PDF_PKI_ALLOWED_HOSTS=
PDF_PKI_TIMEOUT_MS=5000
PDF_PKI_MAX_AGE_SECONDS=86400
PDF_PKI_CACHE_SECONDS=0
