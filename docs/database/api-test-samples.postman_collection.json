    {
      "name": "6. Thay doi phien/mat khau - chay cuoi va chon tung lenh",
      "item": [
        {
          "name": "Refresh - lưu token mới, không dùng lại token cũ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Refresh - lưu token mới, không dùng lại token cũ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", data.access_token);",
                  "  pm.collectionVariables.set(\"refreshToken\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout refresh token hiện tại",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Logout refresh token hiện tại",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
