        },
        {
          "name": "Chi tiết văn bằng",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cert/{{certUUID}}",
            "description": "Chi tiết văn bằng"
          }
        },
        {
          "name": "Theo MSSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cert/student/{{studentCode}}",
            "description": "Theo MSSV"
          }
        },
        {
          "name": "Lịch sử văn bằng",
          "request": {
