            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cert/{{draftUUID}}/submit",
            "description": "Gửi DRAFT từ import - điền draftUUID riêng",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuedOn\": \"2024-10-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
