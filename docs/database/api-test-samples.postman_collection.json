  "item": [
    {
      "name": "1. Dang nhap - lay token truoc",
      "item": [
        {
          "name": "Login cán bộ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Login cán bộ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\",\n  \"role\": \"university\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", data.access_token);",
                  "  pm.collectionVariables.set(\"refreshToken\", data.refresh_token);",
                  "  pm.collectionVariables.set(\"accountId\", data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Hà Nội - người duyệt và phát hành",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Login Hà Nội - người duyệt và phát hành",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{headquartersEmail}}\",\n  \"password\": \"{{headquartersPassword}}\",\n  \"role\": \"university\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"headquartersToken\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN - chỉ quản trị và audit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Login ADMIN - chỉ quản trị và audit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem hồ sơ đăng nhập",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Xem hồ sơ đăng nhập"
          }
        },
        {
          "name": "Danh sách tài khoản ADMIN",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/users",
            "description": "Danh sách tài khoản ADMIN",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Sinh vien - can tao truoc request",
      "item": [
        {
          "name": "Danh sách sinh viên",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students?page=1&limit=20&search={{studentCode}}",
            "description": "Danh sách sinh viên"
          }
        },
        {
          "name": "Tạo sinh viên/tài khoản chờ kích hoạt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students",
            "description": "Tạo sinh viên/tài khoản chờ kích hoạt",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sinh viên kiểm thử\",\n  \"email\": \"{{studentEmail}}\",\n  \"studentId\": \"{{studentCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Import tài khoản sinh viên từ Excel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/import",
            "description": "Import tài khoản sinh viên từ Excel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"{{studentXlsxFileName}}\",\n  \"fileData\": \"{{studentXlsxBase64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Gửi OTP - cần hộp thư thật do anh kiểm soát và SMTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/send-otp",
            "description": "Gửi OTP - cần hộp thư thật do anh kiểm soát và SMTP",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mssv\": \"{{studentCode}}\",\n  \"email\": \"{{studentEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Kích hoạt sinh viên - OTP vừa nhận",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Kích hoạt sinh viên - OTP vừa nhận",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mssv\": \"{{studentCode}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"Student-Local-2026!\",\n  \"otp\": \"{{otp}}\",\n  \"role\": \"student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3. So goc - preview stage review commit",
      "item": [
        {
          "name": "Danh mục ngành - lưu PROGRAM_ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/programs",
            "description": "Danh mục ngành - lưu PROGRAM_ID"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const program = pm.response.json().find(item => item.name === \"Công nghệ thông tin\");",
                  "  if (program) pm.collectionVariables.set(\"programId\", program.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Preview sổ gốc",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/registry/preview",
            "description": "Preview sổ gốc",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"{{xlsxFileName}}\",\n  \"fileData\": \"{{xlsxBase64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Stage sổ gốc - lưu BATCH_ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/registry",
            "description": "Stage sổ gốc - lưu BATCH_ID",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"{{xlsxFileName}}\",\n  \"fileData\": \"{{xlsxBase64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"batchId\", pm.response.json().batchId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Danh sách batch",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports?page=1&limit=20",
            "description": "Danh sách batch"
          }
        },
        {
          "name": "Dòng cần đối soát - lưu ROW_ID đầu tiên",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/{{batchId}}/rows?page=1&limit=20&status=NEEDS_REVIEW",
            "description": "Dòng cần đối soát - lưu ROW_ID đầu tiên"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const rows = pm.response.json().data;",
                  "  if (rows.length) pm.collectionVariables.set(\"rowId\", rows[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sửa đúng dòng đã đối soát",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/{{batchId}}/rows/{{rowId}}",
            "description": "Sửa đúng dòng đã đối soát",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"corrections\": {\n    \"studentCode\": \"{{studentCode}}\",\n    \"fullName\": \"Sinh viên kiểm thử\",\n    \"dateOfBirth\": \"2002-01-01\",\n    \"programId\": \"{{programId}}\",\n    \"graduationYear\": 2024,\n    \"gpa\": null,\n    \"gpaScale\": 4,\n    \"classification\": \"GOOD\",\n    \"certificateNo\": \"TEST-{{testRunId}}-IMPORT\",\n    \"registryNo\": \"TEST/{{testRunId}}/IMPORT\",\n    \"issuedOn\": \"2024-10-15\"\n  },\n  \"note\": \"Đã đối soát hồ sơ kiểm thử\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Commit READY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/{{batchId}}/commit",
            "description": "Commit READY",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Alias ngành",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/imports/program-aliases",
            "description": "Alias ngành",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"{{programId}}\",\n  \"originalName\": \"CNTT - hệ chính quy\",\n  \"note\": \"Đã đối chiếu ngành chuẩn\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Van bang - mau cu duoc gom lai",
      "item": [
        {
          "name": "Lập yêu cầu - lưu UUID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cert/request",
            "description": "Lập yêu cầu - lưu UUID",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mssv\": \"{{studentCode}}\",\n  \"fullName\": \"Sinh viên kiểm thử\",\n  \"dob\": \"2002-01-01\",\n  \"major\": \"Công nghệ thông tin\",\n  \"gpa\": null,\n  \"grade\": \"Khá\",\n  \"soHieu\": \"TEST-{{testRunId}}-001\",\n  \"soVaoSo\": \"TEST/{{testRunId}}/001\",\n  \"className\": \"TEST-IT\",\n  \"namTotNghiep\": 2024,\n  \"issueDate\": \"2024-10-15\",\n  \"org\": \"ORG2\",\n  \"degreeType\": \"BACHELOR\",\n  \"majorNameEn\": \"Information Technology\",\n  \"issuePlace\": \"Hà Nội\",\n  \"diplomaSignerName\": \"Người ký bằng kiểm thử\",\n  \"diplomaSignerTitle\": \"HIỆU TRƯỞNG\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set(\"certUUID\", pm.response.json().uuid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Gửi DRAFT từ import - điền draftUUID riêng",
          "request": {
