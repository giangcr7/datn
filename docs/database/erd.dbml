Ref import_document_scope: import_batches.(document_id, institution_id) > source_documents.(id, institution_id)
Ref import_rows_batch_id_fkey: import_rows.batch_id > import_batches.id
Ref import_rows_reviewed_by_id_fkey: import_rows.reviewed_by_id > accounts.id
Ref integrity_alerts_diploma_id_fkey: integrity_alerts.diploma_id > diplomas.id
Ref integrity_alerts_resolved_by_id_fkey: integrity_alerts.resolved_by_id > accounts.id
Ref otp_challenges_account_id_fkey: otp_challenges.account_id > accounts.id
