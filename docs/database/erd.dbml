Ref diploma_issuer_scope: diplomas.(issuing_campus_id, institution_id) > campuses.(id, institution_id)
Ref diplomas_approved_by_id_fkey: diplomas.approved_by_id > accounts.id
Ref diplomas_campus_id_fkey: diplomas.campus_id > campuses.id
Ref diplomas_graduation_id_fkey: diplomas.graduation_id > graduation_records.id
Ref diplomas_institution_id_fkey: diplomas.institution_id > institutions.id
Ref diplomas_issuing_campus_id_fkey: diplomas.issuing_campus_id > campuses.id
Ref diplomas_requested_by_id_fkey: diplomas.requested_by_id > accounts.id
Ref diplomas_supersedes_id_fkey: diplomas.supersedes_id - diplomas.id
Ref enrollments_campus_id_fkey: enrollments.campus_id > campuses.id
Ref enrollments_class_id_fkey: enrollments.class_id > academic_classes.id
Ref enrollments_program_id_fkey: enrollments.program_id > programs.id
Ref enrollments_student_id_fkey: enrollments.student_id > students.id
Ref decision_document_scope: graduation_decisions.(source_document_id, institution_id) > source_documents.(id, institution_id)
Ref graduation_decisions_institution_id_fkey: graduation_decisions.institution_id > institutions.id
Ref graduation_decisions_source_document_id_fkey: graduation_decisions.source_document_id > source_documents.id
Ref graduation_decision_scope: graduation_records.(decision_id, institution_id) > graduation_decisions.(id, institution_id)
Ref graduation_program_scope: graduation_records.(program_id, institution_id) > programs.(id, institution_id)
Ref graduation_records_decision_id_fkey: graduation_records.decision_id > graduation_decisions.id
Ref graduation_records_enrollment_id_fkey: graduation_records.enrollment_id > enrollments.id
Ref graduation_records_institution_id_fkey: graduation_records.institution_id > institutions.id
Ref graduation_records_program_id_fkey: graduation_records.program_id > programs.id
Ref graduation_records_source_row_id_fkey: graduation_records.source_row_id - import_rows.id
Ref graduation_records_student_id_fkey: graduation_records.student_id > students.id
Ref graduation_student_scope: graduation_records.(student_id, institution_id) > students.(id, institution_id)
Ref import_batches_campus_id_fkey: import_batches.campus_id > campuses.id
Ref import_batches_created_by_id_fkey: import_batches.created_by_id > accounts.id
Ref import_batches_document_id_fkey: import_batches.document_id > source_documents.id
Ref import_batches_institution_id_fkey: import_batches.institution_id > institutions.id
